enum PostType {
  LOST
  FOUND
}

model Post {
  id          Int         @id @default(autoincrement())
  title       String
  description String
  type        PostType // LOST or FOUND (current status)
  creatorId   Int
  creator     User        @relation(fields: [creatorId], references: [id])
  comments    Comment[]
  reactions   Reaction[]
  lostMatches  ItemMatch[] @relation("LostPostMatches")
  foundMatches ItemMatch[] @relation("FoundPostMatches")
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum MatchStatus {
  PENDING
  REVIEWED
  DISMISSED
  CONFIRMED
}

model ItemMatch {
  id          Int         @id @default(autoincrement())
  lostPostId  Int
  foundPostId Int
  score       Float
  status      MatchStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  lostPost  Post @relation("LostPostMatches", fields: [lostPostId], references: [id], onDelete: Cascade)
  foundPost Post @relation("FoundPostMatches", fields: [foundPostId], references: [id], onDelete: Cascade)

  @@unique([lostPostId, foundPostId])
  @@index([lostPostId])
  @@index([foundPostId])
  @@index([score])
}

model Comment {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      Post      @relation(fields: [postId], references: [id])
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id])
  parentId  Int?
  parent    Comment?  @relation("CommentToReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentToReplies")
  depth     Int       @default(3)
  content   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum ReactionType {
  LIKE
  SAD
}

model Reaction {
  id        Int          @id @default(autoincrement())
  type      ReactionType @default(LIKE)
  postId    Int
  post      Post         @relation(fields: [postId], references: [id])
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([postId, userId]) // Compound unique constraint
  @@index([postId])
  @@index([userId])
}
